rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single private table for the group. Every visitor signs in anonymously,
    // so this blocks raw unauthenticated access to the database.
    // TODO: tighten per role (GM vs owner) once real accounts exist.
    match /campaigns/{campaignId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null;
    }
  }
}
